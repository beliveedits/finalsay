    }
    sh.appendRow(safeRow_([label, value, '']));
  }

  function timeZone() { return ss_().getSpreadsheetTimeZone(); }

  /** Adds an optional Leads column (such as Phone) at the end if it is not there yet. */
  function ensureLeadColumn(header) {
