    sh.getRange(2, 1, rows.length, SELF_CHECK_HEADERS.length).setValues(rows.map(function (r) {
      return safeRow_([CRM.oneLine(r.check, 120), CRM.oneLine(r.result, 20), CRM.clean(r.detail, 500), now]);
